# ======================================================
# Forza Fuel Overlay - Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ======================================================

# --- Telemetry Service (apps/telemetry) ---
# Network host interface for the UDP receiver (0.0.0.0 listens on all interfaces)
FORZA_UDP_HOST=0.0.0.0

# UDP Port configured in Forza Horizon "Data Out" settings
FORZA_UDP_PORT=5300

# Port for WebSocket server broadcasting live telemetry data to the UI
FORZA_WS_PORT=8080

# Enable mock telemetry generator for testing without running the game (true/false)
MOCK_TELEMETRY=false


# --- Overlay Frontend & Electron (apps/overlay) ---
# WebSocket URL for the React UI to connect to the Telemetry Service
VITE_WS_URL=ws://localhost:8080

# Development server URL for Electron window in dev mode
VITE_DEV_SERVER_URL=http://localhost:5173

# Environment mode (development / production)
NODE_ENV=development
